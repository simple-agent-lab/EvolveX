# FROZEN — pins for the canonical harness protocol (invariant #1).
# The whole point: one ruler, all generations. Version bumps happen outside the
# loop (human-only front door), recorded as harness_version in every stamp.
HARNESS_VERSION="stub-v1"
N_TASKS=20

# M1 (harbor) pins — filled when the real harness lands:
# HARBOR_VERSION="…"
# DATASET="terminal-bench@2.0"
# N_ATTEMPTS=2
# N_CONCURRENT=4
# HARBOR_ENV="docker"
